# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Auth session secret (min 32 characters)
AUTH_SECRET=change-me-to-a-long-random-secret

# App
NEXT_PUBLIC_APP_NAME=Zid App Platform
# Use your ngrok URL while developing, production domain later
NEXT_PUBLIC_APP_URL=https://your-ngrok-or-domain.com

# Set to false after running database/schema.sql + seed.sql
NEXT_PUBLIC_USE_MOCK_DATA=true

# Zid Partner App credentials (Partner Dashboard → App Keys)
# Partner Redirect URL:  {NEXT_PUBLIC_APP_URL}/api/zid/auth
# Partner Callback URL:  {NEXT_PUBLIC_APP_URL}/api/zid/callback
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
# Optional manual/demo fallback (prefer OAuth; never commit real tokens)
# ZID_STORE_ID=
# ZID_ACCESS_TOKEN=
# ZID_AUTHORIZATION_TOKEN=
# ZID_STORE_NAME=
